<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Biarkan file/folder yang benar-benar ada (assets, favicon, dll) lolos apa adanya
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Semua route lain (hasil client-side routing React Router) dikembalikan ke index.html
  RewriteRule ^ index.html [L]
</IfModule>
